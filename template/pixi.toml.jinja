[workspace]
name = "{{ workspace_name }}"
channels = ["conda-forge"]
platforms = ["linux-64"]

[dependencies]
python = ">=3.13"
git = "*"

[pypi-dependencies]
fasthep-dev-workbench = { git = {{ package_repository | tojson }}, rev = {{ package_ref | tojson }} }

[tasks]
status = "dev-workbench status"
discover = "dev-workbench discover"
checkout = "dev-workbench checkout"
